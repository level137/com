<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>富源六中 · 让大山的孩子走进深山</title>
    <!-- Font Awesome 图标库（仅用于通用图标，已移除社交图标） -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ========== 全局重置 & 基础（蓝白风格） ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #1a73e8;          /* 主蓝色 */
            --primary-light: #4a8cf7;
            --primary-dark: #0d47a1;
            --accent: #1a73e8;            /* 强调色沿用蓝色 */
            --accent-light: #e3f2fd;      /* 淡蓝背景 */
            --gray-bg: #f5f9ff;           /* 浅蓝灰 */
            --text-dark: #1e2b37;
            --text-muted: #5a6f7e;
            --white: #ffffff;
            --shadow: 0 8px 30px rgba(26, 115, 232, 0.10);
            --shadow-hover: 0 16px 48px rgba(26, 115, 232, 0.18);
            --radius: 16px;
            --transition: 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: var(--gray-bg);
            color: var(--text-dark);
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        ul {
            list-style: none;
        }
        img {
            max-width: 100%;
            display: block;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ========== 按钮 ========== */
        .btn {
            display: inline-block;
            padding: 12px 32px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            letter-spacing: 0.3px;
        }
        .btn-primary {
            background: var(--primary);
            color: var(--white);
            box-shadow: 0 4px 16px rgba(26, 115, 232, 0.3);
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(26, 115, 232, 0.4);
        }
        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }
        .btn-outline:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-2px);
        }
        .btn-accent {
            background: var(--primary);
            color: var(--white);
            box-shadow: 0 4px 16px rgba(26, 115, 232, 0.35);
        }
        .btn-accent:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* ========== 导航栏 ========== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.04);
            transition: var(--transition);
            padding: 12px 0;
        }
        .navbar.scrolled {
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        }
        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary);
        }
        .logo i {
            font-size: 2rem;
            color: var(--primary);
        }
        .logo span {
            color: var(--primary-dark);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-links a {
            padding: 8px 18px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.95rem;
            color: var(--text-dark);
            transition: var(--transition);
            position: relative;
        }
        .nav-links a:hover,
        .nav-links a.active {
            background: var(--primary);
            color: var(--white);
        }
        .nav-links a.active {
            background: var(--primary);
            color: var(--white);
        }

        .nav-toggle {
            display: none;
            font-size: 1.6rem;
            background: none;
            border: none;
            color: var(--primary);
            cursor: pointer;
            padding: 4px 8px;
        }

        /* ========== Hero ========== */
        .hero {
            padding: 140px 0 80px;
            background: linear-gradient(145deg, #e8f0fe 0%, #d2e3fc 100%);
            position: relative;
            overflow: hidden;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .hero::before {
            content: '';
            position: absolute;
            right: -10%;
            top: -20%;
            width: 60%;
            height: 140%;
            background: radial-gradient(ellipse at 70% 50%, rgba(26, 115, 232, 0.06) 0%, transparent 70%);
            pointer-events: none;
        }
        .hero .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            position: relative;
            z-index: 2;
        }
        .hero-content h1 {
            font-size: 3.6rem;
            font-weight: 800;
            line-height: 1.2;
            color: var(--primary-dark);
            margin-bottom: 20px;
        }
        .hero-content h1 .highlight {
            color: var(--primary);
            position: relative;
        }
        .hero-content p {
            font-size: 1.2rem;
            color: var(--text-muted);
            max-width: 520px;
            margin-bottom: 32px;
        }
        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }
        .hero-stats {
            display: flex;
            gap: 48px;
            margin-top: 40px;
            padding-top: 32px;
            border-top: 2px solid rgba(26, 115, 232, 0.12);
        }
        .hero-stats .stat h3 {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--primary);
        }
        .hero-stats .stat p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }

        .hero-image {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .hero-image .img-placeholder {
            width: 100%;
            max-width: 520px;
            aspect-ratio: 4/3;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: var(--radius);
            box-shadow: 0 24px 60px rgba(26, 115, 232, 0.25);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 1.2rem;
            font-weight: 500;
            text-align: center;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        .hero-image .img-placeholder i {
            font-size: 5rem;
            margin-bottom: 16px;
            opacity: 0.9;
        }
        .hero-image .img-placeholder .badge {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(4px);
            padding: 6px 20px;
            border-radius: 40px;
            font-size: 0.85rem;
            margin-top: 12px;
        }
        .hero-image .img-placeholder::after {
            content: '';
            position: absolute;
            top: -30%;
            right: -20%;
            width: 60%;
            height: 80%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
            pointer-events: none;
        }

        /* ========== 通用标题 ========== */
        .section-title {
            text-align: center;
            margin-bottom: 48px;
        }
        .section-title h2 {
            font-size: 2.6rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }
        .section-title p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 560px;
            margin: 0 auto;
        }
        .section-title .line {
            width: 60px;
            height: 4px;
            background: var(--primary);
            border-radius: 4px;
            margin: 12px auto 0;
        }

        /* ========== 关于 ========== */
        .about {
            padding: 80px 0;
            background: var(--white);
        }
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .about-text h3 {
            font-size: 2rem;
            color: var(--primary-dark);
            margin-bottom: 16px;
        }
        .about-text p {
            color: var(--text-muted);
            margin-bottom: 16px;
            font-size: 1.05rem;
        }
        .about-text .features {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
                       margin-top: 24px;
        }
        .about-text .features li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 500;
            color: var(--text-dark);
        }
        .about-text .features li i {
            color: var(--primary);
            font-size: 1.2rem;
        }
        .about-image .img-placeholder {
            width: 100%;
            aspect-ratio: 4/3;
            background: linear-gradient(145deg, #d2e3fc, #b0cff5);
            border-radius: var(--radius);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--primary-dark);
            font-weight: 500;
            box-shadow: var(--shadow);
        }
        .about-image .img-placeholder i {
            font-size: 4rem;
            color: var(--primary);
            margin-bottom: 12px;
        }

        /* ========== 课程 ========== */
        .courses {
            padding: 80px 0;
            background: var(--gray-bg);
        }
        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 30px;
        }
        .course-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 32px 28px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            text-align: center;
            border: 1px solid rgba(26, 115, 232, 0.06);
        }
        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
            border-color: var(--primary-light);
        }
        .course-card .icon {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: 16px;
        }
        .course-card h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: var(--primary-dark);
        }
        .course-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* ========== 师资（修复：移除社交链接） ========== */
        .teachers {
            padding: 80px 0;
            background: var(--white);
        }
        .teacher-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
        }
        .teacher-card {
            background: var(--gray-bg);
            border-radius: var(--radius);
            padding: 28px 20px 24px;
            text-align: center;
            transition: var(--transition);
            border: 1px solid transparent;
        }
        .teacher-card:hover {
            border-color: var(--primary-light);
            box-shadow: var(--shadow);
            transform: translateY(-4px);
        }
        .teacher-card .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            color: var(--white);
            font-weight: 600;
        }
        .teacher-card h4 {
            font-size: 1.15rem;
            color: var(--primary-dark);
        }
        .teacher-card .title {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        /* 移除社交链接，不再显示 */

        /* ========== 校园风采 ========== */
        .gallery {
            padding: 80px 0;
            background: var(--gray-bg);
        }
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 24px;
        }
        .gallery-item {
            border-radius: var(--radius);
            overflow: hidden;
            aspect-ratio: 4/3;
            background: linear-gradient(145deg, #d2e3fc, #b0cff5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--primary-dark);
            font-weight: 500;
            box-shadow: var(--shadow);
            transition: var(--transition);
            position: relative;
        }
        .gallery-item:hover {
            transform: scale(1.02);
            box-shadow: var(--shadow-hover);
        }
        .gallery-item i {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: 8px;
        }
        .gallery-item .tag {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            padding: 4px 16px;
            border-radius: 40px;
            font-size: 0.85rem;
        }

        /* ========== 新闻 ========== */
        .news {
            padding: 80px 0;
            background: var(--white);
        }
        .news-grid {
              display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        .news-card {
            background: var(--gray-bg);
            border-radius: var(--radius);
            padding: 28px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            border-left: 4px solid var(--primary);
        }
        .news-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }
        .news-card .date {
            font-size: 0.85rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .news-card h4 {
            font-size: 1.2rem;
            margin: 8px 0 10px;
            color: var(--primary-dark);
        }
        .news-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }
        .news-card .read-more {
            display: inline-block;
            margin-top: 12px;
            font-weight: 600;
            color: var(--primary);
        }
        .news-card .read-more i {
            transition: var(--transition);
        }
        .news-card .read-more:hover i {
            transform: translateX(4px);
        }

        /* ========== 招生 ========== */
        .admission {
            padding: 80px 0;
            background: linear-gradient(145deg, var(--primary-dark), var(--primary));
            color: var(--white);
        }
        .admission .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .admission-info h2 {
            font-size: 2.6rem;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .admission-info p {
            opacity: 0.85;
            font-size: 1.1rem;
            max-width: 480px;
            margin-bottom: 24px;
        }
        .admission-info .btn {
            background: var(--white);
            color: var(--primary);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }
        .admission-info .btn:hover {
            background: var(--accent-light);
            transform: translateY(-2px);
        }
        .admission-features {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .admission-features .feat {
            background: rgba(255, 255, 255, 0.10);
            backdrop-filter: blur(4px);
            padding: 20px 24px;
            border-radius: var(--radius);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .admission-features .feat i {
            font-size: 1.8rem;
            margin-bottom: 8px;
            color: #bbdefb;
        }
        .admission-features .feat h4 {
            font-size: 1.1rem;
        }
        .admission-features .feat p {
            opacity: 0.8;
            font-size: 0.9rem;
            margin: 0;
        }

        /* ========== 联系 ========== */
        .contact {
            padding: 80px 0;
            background: var(--white);
        }
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }
        .contact-info h3 {
            font-size: 1.8rem;
            color: var(--primary-dark);
            margin-bottom: 16px;
        }
        .contact-info p {
            color: var(--text-muted);
            margin-bottom: 24px;
        }
        .contact-info .detail {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
        }
        .contact-info .detail i {
            width: 44px;
            height: 44px;
            background: var(--gray-bg);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 1.1rem;
        }
        .contact-info .detail span {
            font-weight: 500;
        }

        .contact-form {
            background: var(--gray-bg);
            padding: 36px 32px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }
        .contact-form h4 {
            font-size: 1.4rem;
            color: var(--primary-dark);
            margin-bottom: 20px;
        }
        .contact-form .form-group {
            margin-bottom: 16px;
        }
        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 14px 18px;
            border: 1px solid #dce4e9;
            border-radius: 10px;
            font-size: 1rem;
            background: var(--white);
            transition: var(--transition);
            font-family: inherit;
        }
        .contact-form input:focus,
        .contact-form textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.10);
        }
        .contact-form textarea {
            resize: vertical;
            min-height: 120px;
        }
        .contact-form .btn {
            width: 100%;
            justify-content: center;
        }

        /* ========== 页脚 ========== */
        .footer {
            background: var(--primary-dark);
            color: rgba(255, 255, 255, 0.7);
            padding: 48px 0 32px;
        }
        .footer .container {
            display: grid;
            grid-template-columns: 2fr 1.2fr 1fr 1fr 1fr;
            gap: 30px;
        }
        .footer h4 {
            color: var(--white);
            font-size: 1.1rem;
            margin-bottom: 16px;
        }
        .footer a {
            display: block;
            margin-bottom: 8px;
            transition: var(--transition);
        }
        .footer a:hover {
            color: var(--white);
        }
        .footer .logo {
            color: var(--white);
        }
        .footer .logo i {
            color: #bbdefb;
        }
        .footer .copyright {
            grid-column: 1 / -1;
            text-align: center;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.9rem;
            margin-top: 16px;
        }
        /* 页脚名师风采高亮 */
        .footer .teacher-highlight a {
            color: #bbdefb;
            font-weight: 500;
        }
        .footer .teacher-highlight a:hover {
            color: #ffffff;
        }

        /* ========== 响应式 ========== */
        @media (max-width: 992px) {
            .hero .container {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-content p {
                margin: 0 auto 32px;
            }
            .hero-buttons {
                justify-content: center;
            }
            .hero-stats {
                justify-content: center;
            }
            .hero-image .img-placeholder {
                max-width: 400px;
                margin: 0 auto;
            }
            .about-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .about-text .features {
                justify-items: center;
            }
            .admission .container {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .admission-info p {
                margin: 0 auto 24px;
            }
            .admission-features {
                grid-template-columns: 1fr 1fr;
            }
            .contact-grid {
                grid-template-columns: 1fr;
            }
            .footer .container {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
                flex-direction: column;
                background: var(--white);
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                padding: 20px 24px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
                border-radius: 0 0 var(--radius) var(--radius);
                gap: 4px;
            }
            .nav-links.open {
                display: flex;
            }
            .nav-toggle {
                display: block;
            }
            .hero-content h1 {
                font-size: 2.6rem;
            }
            .hero-stats {
                flex-wrap: wrap;
                gap: 24px;
            }
            .section-title h2 {
                font-size: 2rem;
            }
            .admission-features {
                grid-template-columns: 1fr;
            }
            .footer .container {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .footer .logo {
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .hero-content h1 {
                font-size: 2rem;
            }
            .course-grid {
                grid-template-columns: 1fr;
            }
            .teacher-grid {
                grid-template-columns: 1fr 1fr;
            }
            .gallery-grid {
                grid-template-columns: 1fr 1fr;
            }
            .news-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- ==================== 导航栏 ==================== -->
    <header class="navbar" id="navbar">
        <div class="container">
            <a href="#" class="logo">
                <i class="fas fa-graduation-cap"></i>
                富源<span>六中</span>
            </a>
            <button class="nav-toggle" id="navToggle" aria-label="菜单">
                <i class="fas fa-bars"></i>
            </button>
            <nav class="nav-links" id="n            <nav class="nav-links" id="navLinks">
                <a href="#home" class="active">首页</a>
                <a href="#about">关于</a>
                <a href="#courses">课程</a>
                <a href="#teachers">师资</a>
                <a href="#gallery">风采</a>
                <a href="#news">动态</a>
